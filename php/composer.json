{
    "name": "apiverve/webimagescraper",
    "description": "Website Images Scraper is an image scraper API that extracts image URLs and hosting domains from any web page. Send a page URL to retrieve direct image sources, breakdown counts for internal versus external assets, and unique hosting domains.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "webimagescraper",
        "image scraper api",
        "scraper api",
        "scrape images online api",
        "web scraping api for images",
        "scrape images from url"
    ],
    "homepage": "https://apiverve.com/marketplace/webimagescraper?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/webimagescraper",
        "source": "https://github.com/apiverve/webimagescraper-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Webimagescraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Webimagescraper\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
